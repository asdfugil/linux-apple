menuconfig ARCH_S5L8747
	bool "Samsung S5L8747 SoC based platforms"
	depends on ARCH_MULTI_V7
	depends on CPU_LITTLE_ENDIAN
	select ARM_VIC
	select GENERIC_IRQ_CHIP
	select SOC_SAMSUNG
	help
	  This enables support for Samsung S5L8747 SoC.

if ARCH_S5L8747
config CPU_S5L8747
	def_bool y
	help
	  Enable S5L8747 CPU support
endif
